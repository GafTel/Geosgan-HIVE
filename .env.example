# Modelo de litellm (soporta OpenAI, Anthropic, Gemini, Ollama, etc.)
AGENT_MODEL=gpt-4o-mini

# Clave del proveedor que corresponda; litellm la lee directamente del entorno.
# No la compartas ni la subas a git.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...
# GOOGLE_API_KEY=...

# Clave genérica opcional si tu endpoint la usa:
# AGENT_API_KEY=...

AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_STEPS=5
AGENT_TEMPERATURE=0.2
