# GEOSGAN HIVE - global settings (prefix HIVE_).
# Per-agent model/permissions/limits live in config/agents.yaml (YAML), with
# explicit env overrides like HIVE_AGENT_DEVELOPER_MODEL=...
HIVE_CONFIG=config/agents.yaml
# HIVE_USAGE_LOG=logs/usage.jsonl
HIVE_DEFAULT_TIMEOUT_SECONDS=60
HIVE_RETRY_MAX_ATTEMPTS=3
HIVE_RETRY_BASE_DELAY_SECONDS=1.0
HIVE_RETRY_MAX_DELAY_SECONDS=30.0

# Provider credentials - set ONLY the ones for providers you actually use.
# Never share or commit real keys (.env is gitignored).
# OPENAI_API_KEY=sk-...
# MISTRAL_API_KEY=...
# ANTHROPIC_API_KEY=...
# GEMINI_API_KEY=...        (or GOOGLE_API_KEY=...)
# Ollama needs no key: optionally set OLLAMA_API_BASE=http://localhost:11434

# Per-role overrides (examples):
# HIVE_SUPERVISOR_MODEL=openai/gpt-4o
# HIVE_AGENT_DEVELOPER_MODEL=ollama/codellama
# HIVE_AGENT_REVIEWER_TEMPERATURE=0.1

# Collaboration policy overrides (Phase 2; defaults shown):
# HIVE_COLLABORATION_ALLOW_AGENT_TO_AGENT=true
# HIVE_COLLABORATION_MAX_DELEGATION_DEPTH=2
# HIVE_COLLABORATION_MAX_HANDOFFS_PER_RUN=10
# HIVE_COLLABORATION_MAX_PARALLEL_AGENTS=3
# HIVE_COLLABORATION_DEFAULT_DELEGATION_TIMEOUT_SECONDS=120
# HIVE_COLLABORATION_MAX_MODEL_CALLS_PER_RUN=200
